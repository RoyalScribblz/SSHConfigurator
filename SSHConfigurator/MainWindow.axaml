<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSHConfigurator.MainWindow"
        Title="SSH Configurator"
        Width="860" Height="580" MinWidth="580" MinHeight="360">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="{StaticResource PanelBrush}" BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource DividerBrush}">
            <Grid RowDefinitions="3,Auto">
                <Grid ColumnDefinitions="52,10,26,*" IsHitTestVisible="False">
                    <Border Background="{StaticResource AccentBrush}" />
                    <Border Grid.Column="2" Background="{StaticResource SignalBrush}" />
                </Grid>
                <Grid Grid.Row="1" Margin="20,16" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SSH CONFIGURATOR" FontFamily="{StaticResource TerminalFont}"
                                   FontSize="21" FontWeight="Bold" LetterSpacing="1.3" />
                        <TextBlock Text="~/.ssh/config" FontFamily="{StaticResource TerminalFont}"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Manage SSH Keys…"
                            VerticalAlignment="Center" Click="ManageKeysClicked" />
                    <!-- The accent class is supplied by Avalonia's Fluent theme. -->
                    <!-- ReSharper disable once Xaml.StyleClassNotFound -->
                    <Button x:Name="SaveButton" Grid.Column="2" Classes="accent"
                            Content="Save Changes" VerticalAlignment="Center" Click="SaveClicked" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <Border Padding="14,16" BorderThickness="0,0,1,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                    <TextBlock Text="HOSTS" FontFamily="{StaticResource TerminalFont}" FontWeight="Bold"
                               LetterSpacing="1.4" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="HostSearch" Grid.Row="1" Classes="search-field" PlaceholderText="Search hosts"
                             AutomationProperties.Name="Search hosts" TextChanged="SearchChanged" />
                    <ListBox x:Name="HostList" Grid.Row="2" Classes="hosts config-list" Background="Transparent"
                             AutomationProperties.Name="Hosts" SelectionChanged="HostSelected" />
                    <Button x:Name="AddHostButton" Grid.Row="3" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Content="Add Host…" Click="AddHostClicked" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border BorderThickness="3,0,0,0" Padding="12,1,0,2"
                                BorderBrush="{StaticResource SignalBrush}">
                            <TextBlock x:Name="HostTitle" FontFamily="{StaticResource TerminalFont}" FontWeight="Bold"
                                       FontSize="23" TextWrapping="Wrap" />
                        </Border>
                        <Button x:Name="OpenTerminalButton" Grid.Column="1" Content="Open in Terminal"
                                VerticalAlignment="Top" Click="OpenTerminalClicked" />
                    </Grid>
                    <StackPanel x:Name="SettingsPanel" Spacing="8" />
                    <Button x:Name="AddSettingButton" Content="Add Setting…"
                            HorizontalAlignment="Left" Click="AddSettingClicked" />
                    <Expander x:Name="BlockExpander" Header="View config block"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox x:Name="ConfigPreview" Classes="raw-config" FontFamily="{StaticResource TerminalFont}" IsReadOnly="True"
                                 AutomationProperties.Name="Raw SSH config block"
                                 AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="16,8" BorderThickness="0,1,0,0"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
                <Button Grid.Column="1" Content="Reload" Click="ReloadClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
