<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
        <Version>0.1.0</Version>
        <Description>A desktop interface for your OpenSSH client configuration.</Description>
        <AvaloniaVersion>12.1.6</AvaloniaVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SSHConfigurator.IntegrationTests" />
        <AvaloniaResource Include="Assets/AppIcon.png" />
        <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    </ItemGroup>

    <Target Name="CreateMacAppBundle" AfterTargets="Publish"
            Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
        <PropertyGroup>
            <MacAppContents>$(PublishDir)SSH Configurator.app/Contents</MacAppContents>
        </PropertyGroup>
        <Copy SourceFiles="@(ResolvedFileToPublish->'$(PublishDir)%(RelativePath)')"
              DestinationFiles="@(ResolvedFileToPublish->'$(MacAppContents)/MacOS/%(RelativePath)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="Assets/AppIcon.icns" DestinationFolder="$(MacAppContents)/Resources" />
        <Copy SourceFiles="Info.plist" DestinationFolder="$(MacAppContents)" />
    </Target>
</Project>
