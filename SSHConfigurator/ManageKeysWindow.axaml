<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SSHConfigurator"
        x:Class="SSHConfigurator.ManageKeysWindow"
        Title="Manage SSH Keys"
        Width="680" Height="440" MinWidth="500" MinHeight="280"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="SSH KEYS" FontFamily="{StaticResource TerminalFont}" FontSize="20" FontWeight="Bold" />
                <TextBlock x:Name="FolderPath" Text="~/.ssh" FontFamily="{StaticResource TerminalFont}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <!-- The accent class is supplied by Avalonia's Fluent theme. -->
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button x:Name="AddKeyButton" Grid.Column="1" Content="Add Key…"
                    Classes="accent" VerticalAlignment="Center" Click="AddKeyClicked" />
        </Grid>
        <Grid Grid.Row="1" Margin="12,0" ColumnDefinitions="*,140,88" ColumnSpacing="8">
            <TextBlock Text="Filename" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
        </Grid>
        <ListBox x:Name="KeysList" Grid.Row="2" Classes="config-list setting-picker"
                 AutomationProperties.Name="Private SSH key files"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:SshKeyFile">
                    <Grid ColumnDefinitions="*,140,88" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Path}"
                                   FontFamily="{StaticResource TerminalFont}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Type}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Copy Path" ToolTip.Tip="{Binding Path}"
                                Padding="8,5" Click="CopyPathClicked" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock x:Name="KeyStatus" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button x:Name="DefaultFolderButton" Grid.Column="1" Content="Default Folder"
                    Click="DefaultFolderClicked" IsVisible="False" />
            <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="RefreshClicked" />
        </Grid>
    </Grid>
</Window>
